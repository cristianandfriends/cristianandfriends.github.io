---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = profile.description,
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://cristianandfriends.github.io");
const canonical = new URL(Astro.url.pathname, site);
const pageTitle = title
  ? `${title} / ${profile.siteTitle}`
  : profile.siteTitle;
const rssUrl = new URL("/rss.xml", site);
const ogImage = new URL("/og.png", site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#061014" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/favicon-rick-sanchez-48-35bb6309.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="480x480"
      href="/apple-touch-icon-rick-sanchez-480-888209cd.png"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.siteTitle} / musings`}
      href={rssUrl}
    />
    <link
      rel="preload"
      href="/fonts/doto-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/perfect-dos-vga-437.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.siteTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.siteTitleDisplay}, ${profile.eyebrow}`}
    />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="nightlab">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="spectrum" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="screen">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
